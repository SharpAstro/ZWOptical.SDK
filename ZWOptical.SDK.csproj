<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
	<TargetFramework>net10.0</TargetFramework>
	<Nullable>enable</Nullable>
	<RootNamespace>ZWOptical.SDK</RootNamespace>
	<AssemblyName>ZWOptical.SDK</AssemblyName>
	<PackageLicenseFile>license.txt</PackageLicenseFile>
	<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
	<DebugType>embedded</DebugType>
	<PackageId>ZWOptical.SDK</PackageId>
	<PackageReadmeFile>README.md</PackageReadmeFile>
	<PackageTags>Astronomy,ZWO,ASI</PackageTags>
	<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
	<RepositoryUrl>https://github.com/SharpAstro/ZWOptical.SDK</RepositoryUrl>
	<PackageProjectUrl>https://github.com/SharpAstro/ZWOptical.SDK</PackageProjectUrl>
	<PublishRepositoryUrl>true</PublishRepositoryUrl>
	<EmbedUntrackedSources>true</EmbedUntrackedSources>
	<Description>Implements accessing the ZWO ASI, EAF and EFW devices using .NET</Description>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
	<CheckForOverflowUnderflow>False</CheckForOverflowUnderflow>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
	<CheckForOverflowUnderflow>False</CheckForOverflowUnderflow>
  </PropertyGroup>

  <ItemGroup>
	<Compile Remove="demo/**" />
	<EmbeddedResource Remove="demo/**" />
	<None Remove="demo/**" />

	<None Include="license.txt" PackagePath="" Pack="True" />
	<None Include="README.md" PackagePath="" Pack="true" />
	<None Include="lib/win-x64/ASICamera2.dll" PackagePath="runtimes/win-x64/native" Pack="True" />
	<None Include="lib/win-x64/EAFFocuser.dll" PackagePath="runtimes/win-x64/native" Pack="True" />
	<None Include="lib/win-x64/EFWFilter.dll" PackagePath="runtimes/win-x64/native" Pack="True" />
	<None Include="lib/linux-x64/libASICamera2.so" PackagePath="runtimes/linux-x64/native" Pack="True" />
	<None Include="lib/linux-x64/libEAFFocuser.so" PackagePath="runtimes/linux-x64/native" Pack="True" />
	<None Include="lib/linux-x64/libEFWFilter.so" PackagePath="runtimes/linux-x64/native" Pack="True" />
	<None Include="lib/linux-arm64/libASICamera2.so" PackagePath="runtimes/linux-arm64/native" Pack="True" />
	<None Include="lib/linux-arm64/libEAFFocuser.so" PackagePath="runtimes/linux-arm64/native" Pack="True" />
	<None Include="lib/linux-arm64/libEFWFilter.so" PackagePath="runtimes/linux-arm64/native" Pack="True" />
	<None Include="lib/linux-arm/libASICamera2.so" PackagePath="runtimes/linux-arm/native" Pack="True" />
	<None Include="lib/linux-arm/libEAFFocuser.so" PackagePath="runtimes/linux-arm/native" Pack="True" />
	<None Include="lib/linux-arm/libEFWFilter.so" PackagePath="runtimes/linux-arm/native" Pack="True" />
	<None Include="lib/osx-x64/libASICamera2.dylib" PackagePath="runtimes/osx-x64/native" Pack="True" />
	<None Include="lib/osx-x64/libEAFFocuser.dylib" PackagePath="runtimes/osx-x64/native" Pack="True" />
	<None Include="lib/osx-x64/libEFWFilter.dylib" PackagePath="runtimes/osx-x64/native" Pack="True" />
	<None Include="lib/osx-arm64/libASICamera2.dylib" PackagePath="runtimes/osx-arm64/native" Pack="True" />
	<None Include="lib/osx-arm64/libEAFFocuser.dylib" PackagePath="runtimes/osx-arm64/native" Pack="True" />
	<None Include="lib/osx-arm64/libEFWFilter.dylib" PackagePath="runtimes/osx-arm64/native" Pack="True" />
  </ItemGroup>

  <!--
    The PackagePath entries above serve the NuGet package, and ONLY it. The runtimes/rid/native
    layout is a NuGet resolution mechanism, so a consumer taking this project by ProjectReference
    gets the managed assembly and no native library at all. Every SharpAstro consumer does exactly
    that on a dev box, because UseLocalSiblings self-enables when the sibling clone is present, so
    the ZWO camera, focuser and filter wheel found no device there while working perfectly from the
    published package. That is worse than the usual UseLocalSiblings trap: not a stale version but
    an absent capability, and silent, because a missing DllImport target looks the same as nothing
    being plugged in. QHYCCD.SDK has carried this fix for a while, and the ASYMMETRY is how the gap
    was found: on one dev box a QHY camera enumerated and a ZWO one did not, which reads as a ZWO
    driver bug rather than as a difference in how the two projects lay out their natives.

    Copying beside the consumer's binary is the fix: the app directory is where the runtime probes
    for a DllImport, whereas a runtimes folder in an output directory is not probed without the
    deps.json entry only a package supplies. Update rather than a second Include, so the metadata
    lands on the item declared above instead of duplicating it.

    Selected by RID: lib/ is laid out one directory per runtime identifier, so the build's own RID
    names the directory, and a RID this package has no natives for (win-x86, win-arm64, musl)
    copies nothing, which is the honest answer. An OS test alone would be worse than nothing on a
    Raspberry Pi, copying the x64 .so, which fails to load with an error about the file rather than
    an obvious absence.
  -->
  <PropertyGroup>
	<_ZwoNativeRid Condition="'$(RuntimeIdentifier)' != ''">$(RuntimeIdentifier)</_ZwoNativeRid>
	<_ZwoNativeRid Condition="'$(_ZwoNativeRid)' == ''">$(NETCoreSdkPortableRuntimeIdentifier)</_ZwoNativeRid>
	<!-- Never empty past here, so the StartsWith calls below always have a string to run on. -->
	<_ZwoNativeRid Condition="'$(_ZwoNativeRid)' == ''">unknown</_ZwoNativeRid>

	<_ZwoNativeDir Condition="Exists('$(MSBuildThisFileDirectory)lib/$(_ZwoNativeRid)')">lib/$(_ZwoNativeRid)</_ZwoNativeDir>

	<_ZwoNativePrefix Condition="$(_ZwoNativeRid.StartsWith('linux-')) Or $(_ZwoNativeRid.StartsWith('osx-'))">lib</_ZwoNativePrefix>
	<_ZwoNativeSuffix Condition="$(_ZwoNativeRid.StartsWith('win-'))">.dll</_ZwoNativeSuffix>
	<_ZwoNativeSuffix Condition="$(_ZwoNativeRid.StartsWith('linux-'))">.so</_ZwoNativeSuffix>
	<_ZwoNativeSuffix Condition="$(_ZwoNativeRid.StartsWith('osx-'))">.dylib</_ZwoNativeSuffix>
  </PropertyGroup>

  <ItemGroup Condition="'$(_ZwoNativeDir)' != ''">
	<None Update="$(_ZwoNativeDir)/$(_ZwoNativePrefix)ASICamera2$(_ZwoNativeSuffix)" Link="$(_ZwoNativePrefix)ASICamera2$(_ZwoNativeSuffix)" CopyToOutputDirectory="PreserveNewest" />
	<None Update="$(_ZwoNativeDir)/$(_ZwoNativePrefix)EAFFocuser$(_ZwoNativeSuffix)" Link="$(_ZwoNativePrefix)EAFFocuser$(_ZwoNativeSuffix)" CopyToOutputDirectory="PreserveNewest" />
	<None Update="$(_ZwoNativeDir)/$(_ZwoNativePrefix)EFWFilter$(_ZwoNativeSuffix)" Link="$(_ZwoNativePrefix)EFWFilter$(_ZwoNativeSuffix)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!--
    Take TianWen.DAL from the sibling checkout when there is one, self-enabling on Exists().

    Not a convenience. With an unconditional PackageReference, a consumer building both this
    project and TianWen.DAL from source still pulled the PUBLISHED DAL in through here, so two
    assemblies with the same simple name reached the compiler and it refused them (CS1704).
    Raising the sibling's version only wins until CI publishes the next patch of that same minor:
    QHYCCD.SDK hit exactly that while landing DAL 2.1, where 2.1.241 was published, the sibling
    built as 2.1.0, and 2.1.251 then took the lead back. There is no version that stays ahead, so
    the reference has to go away when the source is present.

    A build with no sibling, CI included, is unaffected and still restores the package.
  -->
  <ItemGroup Condition="Exists('$(MSBuildThisFileDirectory)..\TianWen.DAL\TianWen.DAL.csproj')">
	<ProjectReference Include="..\TianWen.DAL\TianWen.DAL.csproj" />
  </ItemGroup>
  <ItemGroup Condition="!Exists('$(MSBuildThisFileDirectory)..\TianWen.DAL\TianWen.DAL.csproj')">
	<PackageReference Include="TianWen.DAL" Version="3.2.*" />
  </ItemGroup>

</Project>
